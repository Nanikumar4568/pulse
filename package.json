{
  "name": "pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted uptime monitor with a public status page",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "seed:prod": "node dist/seed.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.12"
  }
}
